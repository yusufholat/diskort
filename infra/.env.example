# Üç alan adının da DNS A kaydı VPS'in IP adresine yönlenmeli (Cloudflare kullanılıyorsa "DNS only").
DISKORT_DOMAIN=diskort.ornek.com
LIVEKIT_DOMAIN=lk.ornek.com
# Yedek bağlantı (TURN/TLS, 443) için
TURN_DOMAIN=turn.ornek.com

# Rastgele üret: openssl rand -hex 32   (en az 32 karakter)
JWT_SECRET=
LIVEKIT_API_SECRET=

GUILD_NAME=Diskort

# Zorunlu güncelleme: en son yayınlanan masaüstü sürümünden eski uygulamalar bağlanamaz.
# Acil durumda (ör. hatalı sürüm) 0 yapıp `docker compose up -d api` ile geçici olarak kapatılabilir.
# CLIENT_UPDATE_ENFORCE=1
# Mobil uygulamaların bağlanabilmesi için gereken en düşük sürüm (boşsa kural uygulanmaz)
# MIN_ANDROID_VERSION=
# MIN_IOS_VERSION=

# Telefon bildirimleri (FCM): Firebase konsolu → Proje ayarları → Service accounts → Generate new private key
# ile inen JSON'u infra/secrets/fcm.json olarak koy (chmod 600), sonra:
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm.json

# iOS bildirimleri (APNs, Firebase'siz): developer.apple.com → Keys → "Apple Push Notifications service"
# anahtarını (.p8) infra/secrets/apns.p8 olarak koy (chmod 600); ayrıntılar docs/ios.md
# APNS_KEY_FILE=/run/secrets/apns.p8
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=XYZ987TEAM
# IOS_BUNDLE_ID=com.diskort.app

# iPhone cihaz onayı (yönetim paneli → iPhone cihazları → Onayla) sonrası Ad Hoc IPA'yı otomatik derletmek için
# GitHub ince taneli erişim belirteci: yalnızca bu depo, Actions: Read and write. Boşsa panel elle çalıştırılacak
# gh komutunu gösterir. Ayrıntılar docs/ios.md ("Otomatik cihaz ekleme").
# GITHUB_DISPATCH_TOKEN=
# Cihaz listesi iş akışına AES-256-GCM ile şifreli gider (depo herkese açık); GitHub gizli değişkeni
# IOS_DEVICES_KEY ile aynı 32 baytlık base64 anahtar. Yoksa otomatik derleme başlatılmaz.
# IOS_DEVICES_KEY=
# Onaylar toplanıp tek derleme başlatılmadan önce beklenen süre (sn)
# IOS_DISPATCH_DELAY_SEC=180

# Mesajlara eklenen dosyaların tek tek en büyük boyutu (MB, varsayılan 25). Dosyalar diskort-data biriminde
# /data/attachments altında durur; gece yedeği yalnızca veritabanını kapsar (bkz. README, Yedekleme).
# ATTACHMENT_MAX_MB=25

# GIF araması (mesaj kutusundaki GIF düğmesi): GIPHY API anahtarı. developers.giphy.com → Create an App →
# "API" (SDK değil) → anahtarı buraya yaz, sonra `docker compose up -d api`. Boşsa GIF düğmesi gösterilmez.
# GIPHY_API_KEY=
# İçerik sınırı (g, pg, pg-13, r; varsayılan pg-13) ve arama dili (varsayılan tr)
# GIPHY_RATING=pg-13
# GIPHY_LANG=tr
